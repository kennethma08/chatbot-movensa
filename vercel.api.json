{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm --filter @movensa/api build",
  "outputDirectory": "apps/api/dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "regions": ["iad1"],
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ]
}

