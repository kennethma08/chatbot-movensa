# Browser-safe values only (VITE_* is embedded in the web build)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
VITE_API_URL=http://127.0.0.1:3100
VITE_WIDGET_URL=http://127.0.0.1:4174/movensa-widget.js

# API-only secrets
PORT=3100
HOST=127.0.0.1
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
SUPABASE_SECRET_KEY=replace-with-server-secret-key
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SECRET_ENCRYPTION_KEY=replace-with-32-byte-base64-key
ALLOWED_ORIGINS=http://127.0.0.1:5173
PUBLIC_API_URL=http://127.0.0.1:3100
PUBLIC_WIDGET_URL=http://127.0.0.1:4174/movensa-widget.js
LOG_LEVEL=info

# One-time migration inputs
SQLSERVER_URL=Server=(localdb)\\MSSQLLocalDB;Database=chatbotapi_migration_audit;Trusted_Connection=True;Encrypt=False
MIGRATION_DATA_DIR=./scripts/migration/data
LEGACY_WEBCHAT_ASSETS_DIR=../_shared/webchatbot-assets
